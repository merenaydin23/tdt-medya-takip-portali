# =================================================================
# AZERBAYCAN BÜYÜKELÇİLİĞİ MEDYA TAKİP PORTALI - ORTAM DEĞİŞKENLERİ
# =================================================================

# 1. Qwen LLM API Yapılandırması (İletişim Başkanlığı / Custom API)
LLM_BASE_URL=https://llmstat.iletisim.gov.tr/v1
LLM_API_KEY=
LLM_MODEL=qwen-397b

# 2. Yapay Zeka (AI) Yorumlama ve Özet Ayarları (True / False)
# AI ile özet çıkarma ve yorumlamayı açıp kapatmak için:
ENABLE_AI_SUMMARY=False
# LLM ile 2. Aşama filtreleme/sınıflandırmayı açıp kapatmak için:
ENABLE_LLM_STAGE2=False

# 3. SerpApi (Google News API) Anahtarı
SERPAPI_KEY=

# 4. Web Sunucusu Yapılandırması
PORT=5000
HOST=127.0.0.1

# 5. Günlük Otomatik Tarama Saati (24 Saat Formatı HH:MM)
SCHEDULE_TIME=07:30
